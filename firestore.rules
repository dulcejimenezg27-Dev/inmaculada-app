rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin publica con clave local (sin Authentication).
    // Docentes también pueden escribir si están autenticados.
    // Lectura pública para la app de familias.

    match /comunicados/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /puestos/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /eventos/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Me gusta (público, sin login)
    match /likes/{likeId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['comunicadoId', 'clientId', 'createdAt'])
        && request.resource.data.comunicadoId is string
        && request.resource.data.clientId is string
        && request.resource.data.comunicadoId.size() > 0
        && request.resource.data.comunicadoId.size() < 80
        && request.resource.data.clientId.size() >= 8
        && request.resource.data.clientId.size() <= 64
        && likeId == request.resource.data.comunicadoId + '__' + request.resource.data.clientId;
      allow delete: if true;
      allow update: if false;
    }

    // Perfil docente: sí requiere Authentication (app docentes)
    match /perfiles/{uid} {
      allow read: if true;
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /docentes_autorizados/{email} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
